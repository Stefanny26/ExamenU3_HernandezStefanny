require('dotenv').config();
const express = require('express');
const http = require('http');
const socketIo = require('socket.io');
const passport = require('passport');
const GoogleStrategy = require('passport-google-oauth20').Strategy;
const session = require('express-session');
const jwt = require('jsonwebtoken');
const cookieParser = require('cookie-parser');
const path = require('path');

// Dependency Injection Container
const DIContainer = require('./src/DIContainer');

// Routes
const createAuthRoutes = require('./src/presentation/routes/authRoutes');
const createPageRoutes = require('./src/presentation/routes/pageRoutes');

/**
 * Configuración del servidor Express con arquitectura limpia
 */
class Server {
  constructor() {
    this.app = express();
    this.port = process.env.PORT || 3000;
    this.container = new DIContainer();
    this.server = http.createServer(this.app);
    this.io = socketIo(this.server, {
      cors: {
        origin: "*",
        methods: ["GET", "POST"]
      }
    });

    this._setupMiddleware();
    this._setupRoutes();
    this._setupErrorHandling();
    this._setupSocket();
  }

  /**
   * Configura middlewares globales
   * @private
   */
  _setupMiddleware() {
    // CORS
    this.app.use(cors({
      origin: process.env.NODE_ENV === 'production' 
        ? ['https://tu-dominio.com'] 
        : ['http://localhost:3000'],
      credentials: true
    }));

    // Parsers
    this.app.use(express.json());
    this.app.use(express.urlencoded({ extended: true }));
    this.app.use(cookieParser());

    // Archivos estáticos
    this.app.use(express.static(path.join(__dirname, 'public')));

    // Logging en desarrollo
    if (process.env.NODE_ENV === 'development') {
      this.app.use((req, res, next) => {
        console.log(`${new Date().toISOString()} - ${req.method} ${req.path}`);
        next();
      });
    }

    // Configuración de sesiones
    this.app.use(session({
      secret: process.env.SESSION_SECRET || 'fallback-secret',
      resave: false,
      saveUninitialized: false
    }));

    // Inicializar Passport
    this.app.use(passport.initialize());
    this.app.use(passport.session());

    // Configuración de Google OAuth Strategy
    passport.use(new GoogleStrategy({
      clientID: process.env.GOOGLE_CLIENT_ID,
      clientSecret: process.env.GOOGLE_CLIENT_SECRET,
      callbackURL: process.env.CALLBACK_URL || "http://localhost:3000/auth/google/callback"
    }, (accessToken, refreshToken, profile, done) => {
      // En un caso real, aquí guardarías el usuario en la base de datos
      const user = {
        id: profile.id,
        name: profile.displayName,
        email: profile.emails[0].value,
        photo: profile.photos[0].value
      };
      return done(null, user);
    }));

    passport.serializeUser((user, done) => {
      done(null, user);
    });

    passport.deserializeUser((user, done) => {
      done(null, user);
    });

    // Middleware para verificar JWT
    const verifyJWT = (req, res, next) => {
      const token = req.cookies.token;
      
      if (!token) {
        return res.status(401).json({ error: 'No token provided' });
      }

      try {
        const decoded = jwt.verify(token, process.env.JWT_SECRET || 'fallback-secret');
        req.user = decoded;
        next();
      } catch (error) {
        return res.status(401).json({ error: 'Invalid token' });
      }
    };

    this.verifyJWT = verifyJWT;
  }

  /**
   * Configura las rutas de la aplicación
   * @private
   */
  _setupRoutes() {
    const authController = this.container.get('authController');
    const pageController = this.container.get('pageController');
    const authMiddleware = this.container.get('authMiddleware');

    // Rutas de autenticación
    this.app.use('/auth', createAuthRoutes(authController, authMiddleware));

    // Rutas principales
    this.app.use('/', createPageRoutes(pageController, authMiddleware));

    // Ruta de health check
    this.app.get('/health', (req, res) => {
      res.json({
        status: 'OK',
        timestamp: new Date().toISOString(),
        uptime: process.uptime(),
        environment: process.env.NODE_ENV || 'development'
      });
    });

    // 404 - Not Found
    this.app.use('*', pageController.notFound);

    // Ruta de logout
    this.app.get('/logout', (req, res) => {
      res.clearCookie('token');
      req.logout((err) => {
        if (err) {
          return next(err);
        }
        res.redirect('/');
      });
    });

    // Ruta protegida para obtener el perfil del usuario
    this.app.get('/api/profile', this.verifyJWT, (req, res) => {
      res.json({
        success: true,
        user: req.user
      });
    });

    // Cola de preguntas (en memoria para simplificar)
    let questionQueue = [];
    let questionIdCounter = 1;

    // Ruta protegida para obtener las preguntas
    this.app.get('/api/questions', this.verifyJWT, (req, res) => {
      res.json({
        success: true,
        questions: questionQueue
      });
    });

    // Ruta protegida para añadir una pregunta
    this.app.post('/api/questions', this.verifyJWT, (req, res) => {
      const { question } = req.body;
      
      if (!question || question.trim() === '') {
        return res.status(400).json({ error: 'Question cannot be empty' });
      }

      const newQuestion = {
        id: questionIdCounter++,
        question: question.trim(),
        author: req.user.name,
        authorPhoto: req.user.photo,
        timestamp: new Date().toISOString()
      };

      questionQueue.push(newQuestion);

      // Emitir la nueva pregunta a todos los clientes conectados
      this.io.emit('newQuestion', newQuestion);

      res.json({
        success: true,
        question: newQuestion
      });
    });

    // Ruta para servir la página principal
    this.app.get('/', (req, res) => {
      res.sendFile(path.join(__dirname, 'public', 'index.html'));
    });
  }

  /**
   * Configura manejo de errores
   * @private
   */
  _setupErrorHandling() {
    const pageController = this.container.get('pageController');
    
    // Manejo global de errores
    this.app.use(pageController.serverError);

    // Manejo de proceso no capturado
    process.on('uncaughtException', (error) => {
      console.error('Uncaught Exception:', error);
      process.exit(1);
    });

    process.on('unhandledRejection', (reason, promise) => {
      console.error('Unhandled Rejection at:', promise, 'reason:', reason);
      process.exit(1);
    });
  }

  /**
   * Configura Socket.io
   * @private
   */
  _setupSocket() {
    this.io.on('connection', (socket) => {
      console.log('Usuario conectado:', socket.id);

      // Enviar todas las preguntas existentes al nuevo cliente
      socket.emit('allQuestions', questionQueue);

      socket.on('disconnect', () => {
        console.log('Usuario desconectado:', socket.id);
      });
    });
  }

  /**
   * Inicia el servidor
   */
  start() {
    this.server.listen(this.port, () => {
      console.log(`🚀 Server running on port ${this.port}`);
      console.log(`📝 Environment: ${process.env.NODE_ENV || 'development'}`);
      console.log(`🔗 Local: http://localhost:${this.port}`);
      
      if (process.env.NODE_ENV === 'development') {
        console.log('\n📋 Available endpoints:');
        console.log('  GET  /              - Home page');
        console.log('  GET  /dashboard     - Dashboard (requires auth)');
        console.log('  GET  /auth/login    - Start OAuth login');
        console.log('  GET  /auth/callback - OAuth callback');
        console.log('  POST /auth/logout   - Logout');
        console.log('  GET  /auth/status   - Check auth status');
        console.log('  GET  /health        - Health check');
      }
    });
  }

  /**
   * Obtiene la instancia de Express (útil para testing)
   */
  getApp() {
    return this.app;
  }

  /**
   * Obtiene el container de dependencias
   */
  getContainer() {
    return this.container;
  }
}

// Iniciar servidor si este archivo es ejecutado directamente
if (require.main === module) {
  const server = new Server();
  server.start();
}

module.exports = Server;